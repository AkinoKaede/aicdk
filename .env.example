# Required. Never use a VITE_ prefix for passwords.
CDK_PARTNER_PASSWORD=
CDK_UPSTREAM_URL=https://cdk.bar

# Set the exact external origin in production (HTTPS, no trailing path).
# Leave empty for local development.
PUBLIC_ORIGIN=

# Docker publishes to loopback by default. Put an HTTPS proxy in front.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Optional image override for compose.ghcr.yaml (a release tag or digest).
# CDK_IMAGE=ghcr.io/akinokaede/aicdk:1.0.0

# Proxy header master switch. When false, all forwarding headers are ignored.
TRUST_PROXY_HEADERS=false
# Separate switches for each supported header.
TRUST_X_FORWARDED_FOR=true
TRUST_X_REAL_IP=false
TRUST_CF_CONNECTING_IP=false
TRUST_TRUE_CLIENT_IP=false
# Only enabled headers are considered, in this order.
CLIENT_IP_HEADERS=X-Forwarded-For,X-Real-IP,CF-Connecting-IP,True-Client-IP
# Immediate proxy IP ranges. Empty means no proxy is trusted.
# Example for a local reverse proxy: 127.0.0.1/32,::1/128
# For Docker, use the actual proxy/container network address, not this example.
TRUSTED_PROXY_CIDRS=

# Add for a second upstream when using config.json / compose.multi.yaml.
# SECONDARY_PARTNER_PASSWORD=

# Native execution only (Compose overrides these).
LISTEN_ADDR=:8080
DATA_DIR=./data
# CONFIG_FILE=./config.json

# Optional: release (default), debug, or test. No request-body logging is enabled.
# GIN_MODE=release
